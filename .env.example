GOOGLE_CLIENT_ID=your-google-oauth-web-client-id.apps.googleusercontent.com
# Google Maps Platform: enable "Geocoding API" and use a server-restricted key.
# Keep this value only in .env (never in frontend code or source control).
GOOGLE_MAPS_API_KEY=your-google-maps-server-api-key
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-smtp-username
SMTP_PASS=your-smtp-password-or-app-password
SMTP_FROM="KARMYOGI <no-reply@example.com>"
